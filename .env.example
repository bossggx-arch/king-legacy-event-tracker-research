# King Legacy Global Event Tracker Environment Variables
DATABASE_URL="postgresql://kinglegacy:kinglegacy_pass@postgres:5432/kinglegacy_tracker?schema=public"
USE_EXTERNAL_POSTGRES="true"
PGLITE_DATA_DIR="./.pgdata"

REDIS_URL="redis://redis:6379"
JWT_SECRET="replace-with-a-strong-32-char-random-secret"
AGENT_INGEST_SECRET="replace-with-a-strong-agent-ingest-secret"

# Roblox King Legacy Official Universe & Place IDs
KING_LEGACY_UNIVERSE_ID="1451439645"
KING_LEGACY_FIRST_SEA_PLACE_ID="4520749081"
KING_LEGACY_SECOND_SEA_PLACE_ID="6381829480"
KING_LEGACY_THIRD_SEA_PLACE_ID="15759515082"

# Optional Discord Webhook for event alerts
DISCORD_WEBHOOK_URL=""

# Scanner configuration
SCANNER_ENABLED="true"
SCANNER_INTERVAL_MS="45000"
ROBLOX_API_MAX_PAGES_PER_SEA="3"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
